{
  "name": "flowboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "ng build",
    "dev": "npm run build && wrangler dev",
    "watch": "ng build --watch --configuration development",
    "deploy": "npm run build && wrangler deploy",
    "db:local": "wrangler d1 migrations apply flowboard --local",
    "db:remote": "wrangler d1 migrations apply flowboard --remote",
    "check:worker": "tsc -p worker/tsconfig.json --noEmit",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@angular/core": "~20.3.0",
    "@angular/common": "~20.3.0",
    "@angular/compiler": "~20.3.0",
    "@angular/platform-browser": "~20.3.0",
    "@angular/forms": "~20.3.0",
    "@angular/cdk": "~20.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.8.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "~20.3.0",
    "@angular/cli": "~20.3.0",
    "@angular/compiler-cli": "~20.3.0",
    "typescript": "~5.9.2",
    "wrangler": "4.168.0",
    "@cloudflare/workers-types": "5.20261125.1"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true,
    "lmdb@3.4.2": true,
    "msgpackr-extract@3.0.7": true,
    "workerd@1.20261123.1": true
  }
}
